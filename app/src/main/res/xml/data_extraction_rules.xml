<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exige cifrado extremo a extremo en la nube para cualquier respaldo automático -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="whatsapp_repeater.db" />
        <include domain="database" path="whatsapp_repeater.db-wal" />
        <include domain="database" path="whatsapp_repeater.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="whatsapp_repeater.db" />
        <include domain="database" path="whatsapp_repeater.db-wal" />
        <include domain="database" path="whatsapp_repeater.db-shm" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
