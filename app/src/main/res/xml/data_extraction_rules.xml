<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="whatsapp_repeater.db" />
        <include domain="database" path="whatsapp_repeater.db-wal" />
        <include domain="database" path="whatsapp_repeater.db-shm" />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="updates/" />
        <exclude domain="file" path="db_backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="whatsapp_repeater.db" />
        <include domain="database" path="whatsapp_repeater.db-wal" />
        <include domain="database" path="whatsapp_repeater.db-shm" />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="updates/" />
    </device-transfer>
</data-extraction-rules>
